# Environment Configuration

# API Base URL
# VITE_API_URL=http://pnjrrs-be.test
VITE_API_URL=https://portions-weight-headphones-ave.trycloudflare.com

# Application Environment
VITE_ENV=development

# Application Version
VITE_APP_VERSION=1.0.0

# Application Name
VITE_APP_NAME="Philippine Navy Management System"

# Saan ide-deploy: "apache" (gagawa ng dist/.htaccess) o "netlify" (dist/_headers + dist/_redirects)
DEPLOY_TARGET=netlify
